.next/
node_modules/
out/
dist/
coverage/
test-results/
.tmp/
.codex-artifacts/
*.log
*.err
lint_report*.json
diff_files.txt
tsconfig.tsbuildinfo
.env
.env.*
!.env.example

# MCP config contains secrets (access tokens)
.vscode/mcp.json
arabic-book-corpus-platform/

# UX screenshot harness output
.ux-shots/

# Lexicon OCR cache — paid API output, regenerable, large
.lexicon-cache/

# Python bytecode from tools/
__pycache__/
*.pyc

# Reference lexicon scans in docs/ are third-party copyrighted books (~130 MB).
# This is a public repo: never commit them, and never commit text derived from
# them until the licensing question is settled.
docs/*.pdf
public/data/root-meanings.json

# Video captures (intro/tutorial recordings) — never commit media
*.webm
*.mp4

# Local-only prototypes served by next dev — never shipped.
# Under public/data/ because proxy.ts exempts only /data from locale rewriting.
public/data/_local/
# Generators for those prototypes (experiments, not part of the data pipeline).
scripts/_local/
# Internal working papers — never commit.
docs/_local/
# Third-party books and papers kept for reference (lexicons, concordance,
# QAC papers) — not ours to publish, and too large for the repo.
docs/Resources/

# Generated by next dev / next build, which rewrite it differently; Next says not to track it.
next-env.d.ts
