{
  "name": "quranic-linguistics-observatory",
  "version": "0.6.0",
  "description": "Interactive exploration of Quranic linguistic structure and morphology through dynamic visualizations",
  "license": "GPL-3.0",
  "private": false,
  "homepage": "https://quranobservatory.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/lAvArt/Quranic-Linguistics-Observatory.git"
  },
  "bugs": {
    "url": "https://github.com/lAvArt/Quranic-Linguistics-Observatory/issues"
  },
  "author": {
    "name": "lAvArt",
    "url": "https://github.com/lAvArt"
  },
  "keywords": [
    "quran",
    "corpus",
    "visualization",
    "arabic",
    "linguistics",
    "morphology",
    "d3",
    "nextjs",
    "interactive",
    "graph"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib i18n tests scripts proxy.ts next.config.ts eslint.config.mjs playwright.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify:release": "npm run verify && npm run test:a11y-smoke && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:a11y-smoke": "playwright test tests/e2e/accessibility-smoke.spec.ts",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.ts",
    "test:visual:update": "playwright test tests/e2e/visual-regression.spec.ts --update-snapshots",
    "test:search-validation": "vitest run lib/search/arabicNormalize.test.ts lib/search/queryParser.test.ts lib/search/indexes.test.ts lib/search/searchValidation.test.ts lib/search/collocation.test.ts",
    "eval:search": "tsx scripts/eval-search.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "i18n:check": "node scripts/check-i18n.js",
    "i18n:pseudo": "node scripts/pseudo-localize.js",
    "fetch:morphology": "node scripts/fetch-morphology.js",
    "data:roots": "tsx scripts/build-root-stats.ts",
    "data:names": "tsx scripts/build-name-stats.ts",
    "data:forms": "tsx scripts/build-form-index.ts",
    "audit:search": "tsx scripts/audit-search-coverage.ts",
    "data:lemma-form": "tsx scripts/build-lemma-form-stats.ts",
    "graphs:build": "tsx scripts/build-graph-images.ts",
    "favicon:build": "tsx scripts/build-favicon.ts",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed-corpus.ts",
    "db:email-templates": "dotenv -e .env.local -- tsx scripts/push-email-templates.ts",
    "docs:generate": "concurrently -k -s first \"npm run dev\" \"wait-on http://127.0.0.1:3000 && npx tsx scripts/generate-docs.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.98.0",
    "@types/d3": "^7.4.3",
    "@vercel/analytics": "^2.0.1",
    "d3": "^7.9.0",
    "framer-motion": "^12.33.0",
    "next": "^16.3.2",
    "next-intl": "^4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.3.3",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.3",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "start-server-and-test": "^2.1.3",
    "supabase": "^2.116.0",
    "tsx": "^4.23.13",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.22",
    "esbuild": "^0.28.1"
  }
}
